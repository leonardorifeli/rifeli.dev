{{- /* Feed com conteudo completo: description leva o resumo (compatibilidade) e
content:encoded leva o HTML inteiro do post, que e o que leitores de feed e
pipelines de ingestao usam. */ -}}
{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = .Site }}{{- end -}}
{{- $pages := slice -}}
{{- if or $.IsHome $.IsSection -}}
{{- $pages = $pctx.RegularPages -}}
{{- else -}}
{{- $pages = $pctx.Pages -}}
{{- end -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ (cond (eq .Title .Site.Title) .Site.Title (printf "%s on %s" .Title .Site.Title)) | transform.XMLEscape | safeHTML }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ (or .Description .Site.Params.description "") | plainify | transform.XMLEscape | safeHTML }}</description>
    <generator>Hugo</generator>
    {{- with site.Language.LanguageCode }}
    <language>{{ . }}</language>
    {{- end }}
    {{- with .Site.Copyright }}
    <copyright>{{ . }}</copyright>
    {{- end }}
    {{- if not .Date.IsZero }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "rss" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
    {{- $desc := "" -}}
    {{- with .Description }}{{ $desc = . }}{{ else }}{{ $desc = .Summary | plainify }}{{ end -}}
    <item>
      <title>{{ .Title | transform.XMLEscape | safeHTML }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <description>{{ $desc | transform.XMLEscape | safeHTML }}</description>
      {{- with .Content }}
      <content:encoded>{{ printf "<![CDATA[%s]]>" (. | replaceRE "]]>" "]]&gt;") | safeHTML }}</content:encoded>
      {{- end }}
      {{- range .Params.tags }}
      <category>{{ . | transform.XMLEscape | safeHTML }}</category>
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
